EPUB_TRANSLATOR_API_KEY=sk-your-proxy-key
EPUB_TRANSLATOR_BASE_URL=https://your-proxy.example.com/v1
EPUB_TRANSLATOR_MODEL=gpt-4o-mini
# openai, anthropic, or claude-code.
# If omitted, models beginning with claude- use anthropic.
# claude-code drives the locally installed `claude` CLI in headless mode instead of an
# HTTP API: it needs NO API key and NO base URL (and ignores MODEL/BASE_URL/API_KEY
# entirely), just a `claude` you have already logged in with.
EPUB_TRANSLATOR_PROVIDER=openai

# --- provider=claude-code only ---------------------------------------------------
# Model alias or full name handed to `claude --model` (sonnet / opus / haiku / fable,
# or e.g. claude-sonnet-5). Defaults to sonnet.
EPUB_TRANSLATOR_CLAUDE_CODE_MODEL=sonnet
# Seconds before a single `claude -p` subprocess is killed (process group and all).
# A short group takes ~4s; keep this generous, it only bounds hangs.
EPUB_TRANSLATOR_CLAUDE_CODE_TIMEOUT=600
# Retries per request; backoff is RETRY_INTERVAL doubled each attempt, capped at 120s.
# Auth/flag errors ("Not logged in", unknown option) fail immediately without retrying.
EPUB_TRANSLATOR_CLAUDE_CODE_RETRY_TIMES=5
EPUB_TRANSLATOR_CLAUDE_CODE_RETRY_INTERVAL=6
# Process-wide ceiling on simultaneous `claude` processes. Each one is a full node
# process at ~290MB resident, so 16 in flight is ~4.6GB. The cap applies to BOTH stages
# that shell out (glossary resolution and translation) and is the lower bound in
# practice: EPUB_TRANSLATOR_CONCURRENCY still decides how many groups are in flight, but
# no more than this many are ever running at once. 0 or unset = no cap.
EPUB_TRANSLATOR_CLAUDE_CODE_MAX_CONCURRENCY=0
# Path to the claude binary if it is not on PATH.
# EPUB_TRANSLATOR_CLAUDE_CODE_BIN=/home/you/.local/bin/claude

# Translation groups in flight. 16 is fast and not rate-limited in practice; lower it
# only if your proxy throttles.
EPUB_TRANSLATOR_CONCURRENCY=16

# Glossary resolution batches in flight. Deliberately separate from (and NOT inherited
# from) EPUB_TRANSLATOR_CONCURRENCY: the glossary stage fires a few dozen large JSON
# batches in one burst at the very start of a run, which is what makes flaky proxies
# answer with 524s. Default 4.
# EPUB_TRANSLATOR_GLOSSARY_CONCURRENCY=4
# Fraction of resolution batches that may fail before the run is treated as failed
# (no TSV written, exit code 2) instead of writing a glossary with holes in it.
# EPUB_TRANSLATOR_GLOSSARY_MAX_FAILED_RATIO=0.2

# Defaults are usually fine.
EPUB_TRANSLATOR_TARGET_LANGUAGE=zh
EPUB_TRANSLATOR_SUBMIT=append-block
EPUB_TRANSLATOR_TOKEN_ENCODING=o200k_base
EPUB_TRANSLATOR_CACHE_PATH=.cache/translation
EPUB_TRANSLATOR_LOG_DIR=.cache/logs
