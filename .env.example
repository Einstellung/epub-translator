EPUB_TRANSLATOR_API_KEY=sk-your-proxy-key
EPUB_TRANSLATOR_BASE_URL=https://your-proxy.example.com/v1
EPUB_TRANSLATOR_MODEL=gpt-4o-mini
# openai, anthropic, or claude-code.
# If omitted, models beginning with claude- use anthropic.
# claude-code drives the locally installed `claude` CLI in headless mode instead of an
# HTTP API: it needs NO API key and NO base URL (and ignores MODEL/BASE_URL/API_KEY
# entirely), just a `claude` you have already logged in with.
EPUB_TRANSLATOR_PROVIDER=openai

# --- provider=claude-code only ---------------------------------------------------
# Model alias or full name handed to `claude --model` (sonnet / opus / haiku / fable,
# or e.g. claude-sonnet-5). Defaults to sonnet.
EPUB_TRANSLATOR_CLAUDE_CODE_MODEL=sonnet
# Seconds before a single `claude -p` subprocess is killed (process group and all).
# A short group takes ~4s; keep this generous, it only bounds hangs.
EPUB_TRANSLATOR_CLAUDE_CODE_TIMEOUT=600
# Retries per request; backoff is RETRY_INTERVAL doubled each attempt, capped at 120s.
# Auth/flag errors ("Not logged in", unknown option) fail immediately without retrying.
EPUB_TRANSLATOR_CLAUDE_CODE_RETRY_TIMES=5
EPUB_TRANSLATOR_CLAUDE_CODE_RETRY_INTERVAL=6
# Process-wide ceiling on simultaneous `claude` processes. Each one is a full node
# process at ~290MB resident, so 16 in flight is ~4.6GB. The cap applies to BOTH stages
# that shell out (glossary resolution and translation) and is the lower bound in
# practice: EPUB_TRANSLATOR_CONCURRENCY still decides how many groups are in flight, but
# no more than this many are ever running at once. 0 or unset = no cap.
EPUB_TRANSLATOR_CLAUDE_CODE_MAX_CONCURRENCY=0
# Path to the claude binary if it is not on PATH.
# EPUB_TRANSLATOR_CLAUDE_CODE_BIN=/home/you/.local/bin/claude

# --- DeepSeek ---------------------------------------------------------------------
# DeepSeek speaks the plain OpenAI chat-completions dialect, so it needs no provider of
# its own - leave EPUB_TRANSLATOR_PROVIDER=openai and swap these three lines in:
#
#   EPUB_TRANSLATOR_PROVIDER=openai
#   EPUB_TRANSLATOR_API_KEY=sk-your-deepseek-key
#   EPUB_TRANSLATOR_BASE_URL=https://api.deepseek.com/v1
#   EPUB_TRANSLATOR_MODEL=deepseek-v4-flash
#
# BASE_URL must include the trailing /v1. The two stages build the URL differently:
# the translation stage hands the value to the openai SDK, which appends
# /chat/completions verbatim, while glossary.py's _completions_url() adds the /v1 for
# you. Without it the glossary stage hits /v1/chat/completions and the translation
# stage hits /chat/completions - one of them 404s.
#
# Model: deepseek-v4-flash is the recommended default (cheap, fast, plenty for prose);
# deepseek-v4-pro is the stronger, pricier sibling. deepseek-chat and deepseek-reasoner
# are retired and will not resolve.
#
# Thinking mode is ON by default. Measured against api.deepseek.com on one translation
# request: default = 291 reasoning tokens, 321 completion tokens, 3.4s; with thinking
# disabled = 0 reasoning tokens, 27 completion tokens, 1.1s. Same translation quality for
# this job, and the reasoning text never reaches the translation anyway (the library
# streams and reads only delta.content) - so leaving it on just burns money and time.
# Turn it off with the provider-agnostic passthrough below: the JSON is merged into every
# chat-completions request body, in both the glossary and the translation stage.
EPUB_TRANSLATOR_EXTRA_BODY='{"thinking": {"type": "disabled"}}'
#
# Quoting, as actually parsed by python-dotenv (tested):
#   OK    EPUB_TRANSLATOR_EXTRA_BODY='{"thinking": {"type": "disabled"}}'    <- use this
#   OK    EPUB_TRANSLATOR_EXTRA_BODY={"thinking":{"type":"disabled"}}        (bare works too)
#   OK    trailing "   # comment" after either of the above
#   BREAKS EPUB_TRANSLATOR_EXTRA_BODY="{"thinking": {"type": "disabled"}}"
#          Double quotes around a value containing double quotes: dotenv reports
#          "could not parse statement" and DROPS the variable - the run then silently
#          proceeds with thinking still on. Single quotes have no such problem.
# Count your braces: the value needs TWO closing braces. A truncated value fails at
# startup with an explicit message naming the variable, before any request is sent.
#
# Concurrency: 16 is fine against api.deepseek.com directly. Drop to 4-8 if you start
# seeing 429s; they are retried now (see EPUB_TRANSLATOR_RETRY_TIMES below), but a run
# that spends its time backing off is slower than one that never trips the limit.

# Translation groups in flight. 16 is fast and not rate-limited in practice; lower it
# only if your proxy throttles.
EPUB_TRANSLATOR_CONCURRENCY=16

# Glossary resolution batches in flight. Deliberately separate from (and NOT inherited
# from) EPUB_TRANSLATOR_CONCURRENCY: the glossary stage fires a few dozen large JSON
# batches in one burst at the very start of a run, which is what makes flaky proxies
# answer with 524s. Default 4.
# EPUB_TRANSLATOR_GLOSSARY_CONCURRENCY=4
# Fraction of resolution batches that may fail before the run is treated as failed
# (no TSV written, exit code 2) instead of writing a glossary with holes in it.
# EPUB_TRANSLATOR_GLOSSARY_MAX_FAILED_RATIO=0.2

# Retries per request, and the pause between them. These cover 429 (rate limit), 500,
# 502/503/504, the Cloudflare 520-527 range and 529 - see patches/ and README.
# 402 "insufficient balance" and any 4xx credential error fail immediately, on purpose.
# EPUB_TRANSLATOR_RETRY_TIMES=15
# EPUB_TRANSLATOR_RETRY_INTERVAL=30

# Defaults are usually fine.
EPUB_TRANSLATOR_TARGET_LANGUAGE=zh
EPUB_TRANSLATOR_SUBMIT=append-block
EPUB_TRANSLATOR_TOKEN_ENCODING=o200k_base
EPUB_TRANSLATOR_CACHE_PATH=.cache/translation
EPUB_TRANSLATOR_LOG_DIR=.cache/logs
